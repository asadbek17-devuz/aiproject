# --- Site URL (used for SEO canonical, sitemap and social cards) ---
NEXT_PUBLIC_SITE_URL="https://ai-academy.uz"

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_academy?schema=public"

# --- AI provider: "groq" (default), "openrouter", or "mock" ---
AI_PROVIDER="groq"
AI_MODEL="openai/gpt-oss-120b"
# Mentor suhbatlari uchun tabiiyroq model (bo‘sh bo‘lsa AI_MODEL ishlatiladi)
AI_MENTOR_MODEL="qwen/qwen3.8-27b"
AI_MONTHLY_TOKEN_LIMIT="1200000"

GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# --- TTS (Microsoft Edge TTS) ---
TTS_VOICE="uz-UZ-SardorNeural"
TTS_CACHE_DIR=".cache/tts"

# --- Session ---
SESSION_TTL_DAYS="30"

# --- Sayt bo'yicha AI yordamchi ---
WEBSITE_AI_API_KEY=""
WEBSITE_AI_MODEL="openai/gpt-oss-120b"
